{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Maven coordinates in java/dependencies.txt (group:artifact:version)",
      "managerFilePatterns": ["/^java/dependencies\\.txt$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>[^:\\s#]+:[^:\\s]+):(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "npm packages in npm/packages.txt (name@version)",
      "managerFilePatterns": ["/^npm/packages\\.txt$/"],
      "matchStrings": ["(?:^|\\n)(?<depName>(?:@[^/\\s#]+/)?[^@\\s#]+)@(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "npm"
    }
  ]
}
